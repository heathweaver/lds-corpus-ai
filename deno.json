{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "gate:precommit": "deno task check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "preview": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "introspect": "deno run -A scripts/introspect.ts",
    "theme": "deno run -A scripts/create-theme.ts",
    "metrics": "deno run -A scripts/metrics.ts",
    "test": "deno test --allow-all tests/"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "fmt": { "exclude": ["static/", "**/*.md"] },
  "exclude": ["**/_fresh/*", "twiglit-plugin/"],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "vite": "npm:vite@^7.1.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "postgres": "npm:postgres@^3.4.5",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.41.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "$db": "./lib/db/index.ts"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client", "npm:preact@^10.29.1/jsx-runtime"]
  }
}
