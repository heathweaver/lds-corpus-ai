#!/usr/bin/env bash
# Pre-commit gate: format check + lint + type-check must pass before commit.
# Mirrors the twiglit pre-commit hook (simplified for this repo).
#
# Opt in for this repo with:
#   git config core.hooksPath .githooks
#
# Bypass once (sparingly, with a reason in the commit message):
#   git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"
deno task gate:precommit
