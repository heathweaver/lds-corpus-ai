# --- PostgreSQL (read-only application role) --------------------------------
# The deployed app MUST use a least-privilege, read-only role.
# Do NOT use lds_corpus_ingest here. See sql/readonly_role.sql.
#
# Provide EITHER discrete PG*/DB_* parts (preferred, matches twiglit-notes) ...
PGHOST=ssc.pm
PGPORT=5433
PGDATABASE=lds_corpus
PGUSER=lds_corpus_app
PGPASSWORD=
DB_SCHEMA=lds_corpus
PGSSLMODE=require

# ... OR a single full URL (the DB_* names from the spec also work):
# DATABASE_URL=postgresql://lds_corpus_app:<password>@ssc.pm:5433/lds_corpus?sslmode=require

# Set to "1" only behind a transaction pooler that rejects prepared statements.
PG_DISABLE_PREPARE=0

# --- Answer synthesis (optional) --------------------------------------------
# When ANTHROPIC_API_KEY is set, /research/ask and theme creation generate
# answers/themes and VERIFY every claim against sources (fail-closed). When
# unset, /research/ask returns an extractive (quote-only) answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: a cheaper/stricter model for the verification pass (defaults to
# ANTHROPIC_MODEL).
ANTHROPIC_VERIFIER_MODEL=

# --- Semantic search (optional) ---------------------------------------------
# Enables hybrid (keyword + vector) retrieval. Must match the model the ingest
# pipeline used to embed segments (see the `embedding` table). Without this,
# retrieval is keyword-only.
EMBED_PROVIDER=            # voyage | openai | (empty = keyword-only)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Writable role for internal jobs + demand logging (optional) ------------
# The public app is read-only. Configuring a WRITABLE role (lds_corpus_curator,
# see sql/curator_role.sql) enables: research-question logging (the demand
# signal), near-duplicate query detection, KB metrics over the query log, and
# internal curation writes. Unset = those features are silent no-ops.
APP_PGUSER=                 # e.g. lds_corpus_curator
APP_PGPASSWORD=
# APP_PGHOST / APP_PGPORT / APP_PGDATABASE / APP_PGSSLMODE default to the PG* values.
# APP_DATABASE_URL=postgresql://lds_corpus_curator:<pw>@ssc.pm:5433/lds_corpus?sslmode=require
DEDUP_SIMILARITY=0.6        # trigram threshold for near-duplicate questions

# --- MCP research endpoint (for the Twiglit runtime / AI clients) -----------
# Machine callers authenticate to POST /mcp with a Bearer service token. Unset
# = the /mcp endpoint is disabled (fail closed). Comma-separated allows rotation.
MCP_SERVICE_TOKEN=

# --- Twiglit extension gate (optional) --------------------------------------
# Setting TWIGLIT_APP_URL turns on the session gate: the app's UI is restricted
# to logged-in Twiglit users (see docs/twiglit-integration.md). Unset = the app
# runs standalone with no gating.
TWIGLIT_APP_URL=            # e.g. https://app.twigl.it
TWIGLIT_AUTH_DISABLED=      # "true" bypasses the gate (local dev)
TWIGLIT_ACCESS=any          # any | super_admin | allowlist
TWIGLIT_ALLOWED_EMAILS=     # comma-separated, for the allowlist policy

# Local dev: point at an alternate .env file if desired.
# ENV_FILE=./.env
