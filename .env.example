# --- PostgreSQL -------------------------------------------------------------
# Provide either a full DATABASE_URL, or the discrete DB_* parts below.
# The app builds a URL from the parts when DATABASE_URL is unset.
#
# IMPORTANT: use a READ-ONLY application role here. Do NOT use lds_corpus_ingest.
# See sql/readonly_role.sql for the role definition.
DATABASE_URL=postgresql://<app_user>:<password>@ssc.pm:5433/lds_corpus?sslmode=require

DB_HOST=ssc.pm
DB_PORT=5433
DB_NAME=lds_corpus
DB_SCHEMA=lds_corpus
DB_SSLMODE=require
DB_USER=
DB_PASSWORD=

# Set to "1" if connecting through a transaction pooler (e.g. pgbouncer) that
# does not support prepared statements. Safe default is off.
PG_DISABLE_PREPARE=0

# --- Answer synthesis (optional) --------------------------------------------
# When ANTHROPIC_API_KEY is set, /research/ask asks Claude to compose a grounded
# answer from the retrieved segments. When unset, the API returns an extractive
# answer stitched from the top segments (no external calls, fully offline-safe).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server -----------------------------------------------------------------
PORT=8000
