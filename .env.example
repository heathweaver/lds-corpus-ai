# --- PostgreSQL (read-only application role) --------------------------------
# The deployed app MUST use a least-privilege, read-only role.
# Do NOT use lds_corpus_ingest here. See sql/readonly_role.sql.
#
# Provide EITHER discrete PG*/DB_* parts (preferred, matches twiglit-notes) ...
PGHOST=ssc.pm
PGPORT=5433
PGDATABASE=lds_corpus
PGUSER=lds_corpus_app
PGPASSWORD=
DB_SCHEMA=lds_corpus
PGSSLMODE=require

# ... OR a single full URL (the DB_* names from the spec also work):
# DATABASE_URL=postgresql://lds_corpus_app:<password>@ssc.pm:5433/lds_corpus?sslmode=require

# Set to "1" only behind a transaction pooler that rejects prepared statements.
PG_DISABLE_PREPARE=0

# --- Answer synthesis (optional) --------------------------------------------
# When ANTHROPIC_API_KEY is set, POST /research/ask asks Claude to compose the
# grounded answer from retrieved segments. When unset, the endpoint returns an
# extractive answer stitched from the top segments (no external calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local dev: point at an alternate .env file if desired.
# ENV_FILE=./.env
